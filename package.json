{
  "name": "pdf-resizer",
  "version": "1.0.0",
  "description": "Desktop app that shrinks PDF, image, video, and audio files while keeping quality tunable",
  "main": "./out/main/index.js",
  "author": "lukaszkups",
  "homepage": "https://github.com/lukaszkups/pdf-resizer",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview -- --no-sandbox",
    "dev": "electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "postinstall": "node ./node_modules/electron/install.js && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "compress-pdf": "^0.5.5",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^3.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.4"
  }
}
